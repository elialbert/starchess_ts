// Cloudflare Worker serving the Vite build from dist/ as static assets.
// Deployed by Workers Builds (the Cloudflare dashboard's Git integration) on
// every push to main: build command `npm run build`, deploy `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starchess",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Static files are served without invoking the Worker (free, unmetered);
    // only /api/* reaches worker/index.ts.
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "starchess.elialbert.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
